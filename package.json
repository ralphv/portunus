{
  "name": "portunus",
  "version": "0.x.0",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "predev": "node scripts/script-integrity.mjs stub",
    "dev": "next dev",
    "build": "node scripts/script-integrity.mjs build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build --build-arg APP_VERSION=$npm_package_version -t portunus:latest .",
    "docker:run": "docker run -d --name portunus -p 3000:3000 --env-file .env.local --restart unless-stopped portunus:latest",
    "docker:up": "docker compose up --build -d",
    "docker:save": "docker save portunus:latest | gzip > portunus.tar.gz"
  },
  "dependencies": {
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@vercel/otel": "^2.1.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "hash-wasm": "^4.12.0",
    "libsodium-wrappers": "^0.8.4",
    "lodash": "^4.17.15",
    "lru-cache": "^11.5.3",
    "minimist": "^1.2.0",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "qr-scanner": "^1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "1.56",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
