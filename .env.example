# Portunus configuration — copy to `.env` (or `.env.local` for `npm run dev`)
# and fill in. Placeholders only: never commit real values.
# Full reference: README.md "Configuration" and docs/configuration.md.

# --- Required (Google mode) ---------------------------------------------
# Google OAuth client (each self-hoster creates their own; see
# docs/google-oauth.md).
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
# Session encryption secret: `openssl rand -hex 32` (or `npx auth secret`).
AUTH_SECRET=replace-with-openssl-rand-hex-32
# The app's public origin. Over https://, the server also sends HSTS.
AUTH_URL=http://localhost:3000

# Ed25519 key that signs the Drive vault file: base64 of the DER PKCS#8 key,
# one line (README "Vault signatures"):
#   openssl genpkey -algorithm ed25519 -out portunus-signing.pem
#   openssl pkey -in portunus-signing.pem -outform DER | base64 | tr -d '\n'
# Required unless PORTUNUS_SIGNATURES_DISABLED=1 or demo mode.
PORTUNUS_SIGNING_PRIVATE_KEY=replace-with-base64-der-ed25519-key

# --- Optional -------------------------------------------------------------
# 1 = turn vault signatures off (no key needed; files stored unsigned).
# PORTUNUS_SIGNATURES_DISABLED=1
# 1 = accept legacy unsigned vault files while migrating; remove once every
# vault has been saved again.
# PORTUNUS_ALLOW_MISSING_SIGNATURE=1
# 0 = never re-check edited passwords against Have I Been Pwned (and hide the
# Settings toggle). Default: on.
# PORTUNUS_HIBP_ON_EDIT=0
# 1 = disable offline mode (no ciphertext cache in the browser).
# DISABLE_OFFLINE_MODE=1
# 1 = allow biometric (passkey + PRF) unlock per device. Default: off.
# PORTUNUS_BIOMETRIC_UNLOCK=1
# 0 = saves always need the master password, even with biometric unlock.
# PORTUNUS_BIOMETRIC_SAVE_CONFIRM=0
# 1 = demo mode: stubbed sign-in, in-memory vault, no AUTH_* needed.
# Never use with real secrets.
# PORTUNUS_DEMO_MODE=1
