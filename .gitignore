# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# build-time script allowlist (scripts/script-integrity.mjs) — changes every build
/src/generated/

# misc
.DS_Store
*.pem

# local-only build/deploy helpers
/Makefile

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# keyfiles — never commit vault keys
*.key


# typescript
*.tsbuildinfo
next-env.d.ts

# JetBrains IDE
.idea

# Legacy single-file app — may contain a real vault, never commit
portunus.html
